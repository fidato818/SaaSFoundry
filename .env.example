# Server Port & Host Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Gemini AI API Configuration (Keep Secret Server-Side)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3001"

# Firebase Integration (Optional - only required if connecting to live Firestore/Auth)
# Leave unset or empty to use server in-memory store.
# Do not commit real service account keys to source control.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
